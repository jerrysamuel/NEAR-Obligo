# NEXT_PUBLIC Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Obligo | Private Personal Commerce Agent"

# Supabase (Optional for local memory mode, recommended for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NEAR AI Cloud API (OpenAI-compatible)
# https://cloud.near.ai / https://nearbuilders.org/dashboard
NEAR_AI_API_KEY=your-near-ai-api-key
NEAR_AI_API_URL=https://api.near.ai/v1
NEAR_AI_MODEL=fireworks::llama-v3p3-70b-instruct

# NEAR Blockchain (Testnet)
NEAR_NETWORK_ID=testnet
NEAR_CONTRACT_ID=obligo-permissions.testnet
# Server wallet or relayer (optional for backend-sponsored permission logging)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
